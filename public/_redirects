[build]
command = "npm run build"
publish = "dist"

# The app is fully client-side; every path serves the same SPA shell.
[[redirects]]
from = "/*"
to = "/index.html"
status = 200

# Hashed assets are immutable; index.html must never be cached or updates
# would not reach an installed PWA.
[[headers]]
for = "/assets/*"
[headers.values]
Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/sw.js"
[headers.values]
Cache-Control = "no-cache"

[[headers]]
for = "/index.html"
[headers.values]
Cache-Control = "no-cache"

# Khata is offline-first and talks only to Google APIs, so everything else
# can be locked down tightly.
[[headers]]
for = "/*"
[headers.values]
X-Content-Type-Options = "nosniff"
Referrer-Policy = "no-referrer"
X-Frame-Options = "SAMEORIGIN"
Permissions-Policy = "geolocation=(), camera=(), microphone=()"

<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: Android applies its own mask (circle / squircle / rounded
  square) to the union of the background layer and the foreground. The
  background is the app's own navy-to-green gradient; the foreground is the
  extracted "k" logo inset into the 72dp safe zone.

  Both layers come from public/icons/icon-512.png and are regenerated by
  android/tools/extract_glyph.py. Do not hand-edit the PNGs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>

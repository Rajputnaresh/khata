{
  "name": "khata",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first personal budget tracker with insights and encrypted Google Drive backups.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "python3 scripts/make-icons-from-image.py assets/app-icon-source.png",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:insights": "node scripts/e2e-insights.mjs",
    "test:offline": "node scripts/e2e-offline.mjs",
    "test:layout": "node scripts/e2e-layout.mjs",
    "test:live": "node scripts/e2e-live.mjs",
    "theme": "node scripts/gen-theme.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "verify:m3": "node scripts/verify-m3.mjs",
    "icons:preview": "node scripts/icon-preview.mjs"
  },
  "keywords": [
    "budget",
    "pwa",
    "offline-first",
    "indexeddb",
    "personal-finance"
  ],
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
